# Postgres
POSTGRES_USER=internlink
POSTGRES_PASSWORD=internlink
POSTGRES_DB=internlink
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@internlink.localhost.com
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=5050

# Gateway / Services ports
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
STUDENT_SERVICE_PORT=3002
COMPANY_SERVICE_PORT=3003
OFFER_SERVICE_PORT=3004
APPLICATION_SERVICE_PORT=3005
MESSAGING_SERVICE_PORT=3006
NOTIFICATION_SERVICE_PORT=3007

# Frontend
FRONTEND_PORT=4200

# Auth security
JWT_SECRET=internlink-access-secret
JWT_REFRESH_SECRET=internlink-refresh-secret
OTP_TTL_MINUTES=10

# Optional Gemini API key for AI CV analysis
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

